# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Testing, type-check & coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage/

# Python Virtual environments
.venv/
.venv*/
venv/
env/
ENV/

# Serialized Model Artifacts (Track production model via Git LFS)
models/*.joblib
models/*.pkl
models/*.bin
!models/.gitkeep
!models/random_forest_final.joblib

# Data files (Preserve raw and intermediate data outside Git, track canonical splits)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/train.csv
!data/processed/validation.csv
!data/processed/test.csv

# Heavy generated tables (>50MB or reproducible)
reports/shap_values.csv

# Environment variables and secrets
.env
.env.*
.env*.local
!.env.example
*.pem
*.key
*.token

# Node.js & Next.js build artifacts
node_modules/
.next/
out/
dist/
.turbo/

# Editors and IDEs
.vscode/
.idea/

# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
tmp/
temp/

# Browser & UI test results
playwright-report/
test-results/

# Duplicate folder protection
income-lens-ai-frontend-development/
